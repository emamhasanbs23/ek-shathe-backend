{
  "info": {
    "name": "Ek Shathe API",
    "description": "Ek-Shathe backend API. Organized by module folders (Auth, Trip, \u2026).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "description": "Authentication endpoints",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"postman.user@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves tokens into the active environment so Refresh/Logout can reuse them.",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.accessToken) {",
                  "    pm.environment.set('accessToken', body.data.accessToken);",
                  "  }",
                  "  if (body.data && body.data.refreshToken) {",
                  "    const prev = pm.environment.get('refreshToken');",
                  "    if (prev) pm.environment.set('previousRefreshToken', prev);",
                  "    pm.environment.set('refreshToken', body.data.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Saves tokens into the active environment so Refresh/Logout can reuse them.",
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.accessToken) {",
                  "    pm.environment.set('accessToken', body.data.accessToken);",
                  "  }",
                  "  if (body.data && body.data.refreshToken) {",
                  "    const prev = pm.environment.get('refreshToken');",
                  "    if (prev) pm.environment.set('previousRefreshToken', prev);",
                  "    pm.environment.set('refreshToken', body.data.refreshToken);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/v1/auth/logout",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Trip",
      "description": "Trip create, discover, join request, accept/reject, members, status",
      "item": [
        {
          "name": "Create Trip",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.environment.set('tripId', String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"destination\": \"Cox's Bazar\",\n  \"startDate\": \"2026-12-10\",\n  \"endDate\": \"2026-12-14\",\n  \"capacity\": 4,\n  \"title\": \"Weekend by the sea\",\n  \"description\": \"Optional notes\",\n  \"origin\": \"Dhaka\"\n}"
            }
          }
        },
        {
          "name": "List My Trips",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/mine"
          }
        },
        {
          "name": "Discover Trips",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/discover"
          }
        },
        {
          "name": "Get Trip",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}"
          }
        },
        {
          "name": "Create Join Request",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.data && body.data.id) pm.environment.set('requestId', String(body.data.id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{joinerAccessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/join-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"Happy to join!\"\n}"
            }
          }
        },
        {
          "name": "List Join Requests",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/join-requests?status=PENDING"
          }
        },
        {
          "name": "Accept Join Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/join-requests/{{requestId}}/accept"
          }
        },
        {
          "name": "Reject Join Request",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/join-requests/{{requestId}}/reject"
          }
        },
        {
          "name": "List Members",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/members"
          }
        },
        {
          "name": "Update Trip Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/v1/trips/{{tripId}}/status",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"STARTED\"\n}"
            }
          }
        }
      ]
    }
  ]
}
